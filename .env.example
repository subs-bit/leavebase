# Copy this file to ".env" and fill it in. The .env file is never committed.

# Local development (SQLite, a file on your machine):
DATABASE_URL="file:./leavebase.db"

# Production (PostgreSQL). Run: node scripts/db-provider.mjs postgres
# DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# LeaveBase needs no signing secret. Sessions are opaque random tokens stored in the database
# and revoked by deleting the row, so there is no token to forge.
